{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onsite",
  "version": "0.1.2",
  "identifier": "dev.onsite.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Onsite",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    },
    "linux": {
      "deb": { "depends": ["libasound2"] }
    },
    "resources": {
      "../prompts/": "prompts/",
      "../dossiers/": "dossiers/",
      "../sidecar/": "sidecar/"
    }
  }
}
