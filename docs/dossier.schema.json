{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onsite dossier",
  "type": "object",
  "required": [
    "company",
    "role",
    "summary",
    "style",
    "process",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "jd": {
      "type": "string"
    },
    "preparedAt": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "values": {
      "type": "string"
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "process": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "minutes",
          "questions"
        ],
        "properties": {
          "type": {
            "enum": [
              "resume",
              "project",
              "fundamentals",
              "coding",
              "comprehension",
              "lld",
              "sysdesign",
              "behavioral",
              "hm"
            ]
          },
          "name": {
            "type": "string"
          },
          "minutes": {
            "type": "integer",
            "minimum": 10,
            "maximum": 180
          },
          "what": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}